<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
    <!--     Contra indication tree view -->
    <record id="contract_indication_view_tree" model="ir.ui.view">
        <field name="name">contract.indication.view.tree</field>
        <field name="model">contract.indication</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="blood_donation_question"/>
            </tree>
        </field>
    </record>
    <!--     Contra Indication menu action -->
    <record id="contra_indication_action" model="ir.actions.act_window">
        <field name="name">Contra Indications</field>
        <field name="res_model">contract.indication</field>
        <field name="view_mode">tree</field>
    </record>
    </data>
</odoo>
