<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="room_facility_view_tree" model="ir.ui.view">
            <field name="name">room.facility.view.tree</field>
            <field name="model">room.facility</field>
            <field name="arch" type="xml">
                <tree create="1" editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="room_facility_view_form" model="ir.ui.view">
            <field name="name">room.facility.view.form</field>
            <field name="model">room.facility</field>
            <field name="arch" type="xml">
                <form string="Room Facility">
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>
        <record id="room_facility_action" model="ir.actions.act_window">
            <field name="name">Room Facility</field>
            <field name="res_model">room.facility</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>