<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="view_patient_room_tree" model="ir.ui.view">
            <field name="name">patient.room.tree</field>
            <field name="model">patient.room</field>
            <field name="arch" type="xml">
                <tree string="Patients Room">
                    <field name="name"/>
                    <field name="bed_type"/>
                    <field name="state"/>
                    <field name="floor_no"/>
                </tree>
            </field>
        </record>
        <record id="view_patient_room_form" model="ir.ui.view">
            <field name="name">patient.room.form</field>
            <field name="model">patient.room</field>
            <field name="arch" type="xml">
                <form string="Patients Room">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="bed_type"/>
                            </group>
                            <group>
                                <field name="state"/>
                                <field name="floor_no"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_patient_room" model="ir.actions.act_window">
            <field name="name">Patients Room</field>
            <field name="res_model">patient.room</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_hospital_patient_search"/>
            <field name="context">{'search_default_male_patient': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a room for patients!
                </p>
            </field>
        </record>
    </data>
</odoo>