<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data noupdate="0">
        <record id="module_category_appointment" model="ir.module.category">
            <field name="name">Hospital</field>
            <field name="sequence">1</field>
        </record>

        <record id="group_hospital_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="category_id" ref="om_hospital.module_category_appointment"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">the user will have access to appointment</field>
        </record>

        <record id="group_hospital_doctors" model="res.groups">
            <field name="name">Doctors</field>
            <field name="category_id" ref="om_hospital.module_category_appointment"/>
            <field name="implied_ids" eval="[(4, ref('om_hospital.group_hospital_receptionist'))]"/>
            <field name="comment">the user will have access to patient details</field>
        </record>


        <record id="receptionist_own_appointment_rule" model="ir.rule">
            <field name="name">Receptionist: View own records</field>
            <field name="model_id" ref="model_hospital_appointment"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[Command.set([4, ref('om_hospital.group_hospital_receptionist')])]"/>
        </record>

        <record id="doctor_view_all_appointment_rule" model="ir.rule">
            <field name="name">Doctors: View all appointments records</field>
            <field name="model_id" ref="model_hospital_appointment"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[Command.set([4, ref('om_hospital.group_hospital_doctors')])]"/>
        </record>
    </data>
</odoo>