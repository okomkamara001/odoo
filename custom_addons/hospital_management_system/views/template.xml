<?xml version="1.0" encoding="utf-8"?>


<odoo>
    <data>
        <template id="index" name="Sales">
            <t t-call="website.layout">
                <t t-set="title">Sales Order</t>
                <div class="oe_structure">
                    <div class="container">
                        <t t-foreach="sales" t-as="sale">
                            <p>
                                <t t-esc="sale.name"/>
                            </p>
                        </t>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>