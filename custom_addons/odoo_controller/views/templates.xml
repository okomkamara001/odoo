<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <template id="index">
            <t t-call="website.layout">
                <t t-set="title">Sales Order</t>
                <div class="oe_structure">
                    <div class="container">
                        <t t-foreach="sales" t-as="sale">
                            <p>
                                <a t-attf-href="/odoo_controller/{{ slug(sale) }}">
                                    <t t-esc="sale.name"/>
                                    <t t-esc="sale.partner_id.name"/>
                                </a>
                            </p>
                        </t>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
