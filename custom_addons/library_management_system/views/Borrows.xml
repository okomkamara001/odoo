<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="action_server_cron_job" model="ir.actions.server">
        <field name="name">Check Delayed</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_books_borrows"/>
        <field name="binding_model_id" ref="model_books_borrows"/>
        <field name="state">code</field>
        <field name="code">records.update_delayed_status()</field>
    </record>
    <record model="ir.ui.view" id="view_action_borrowed_form">
        <field name="name">view.books.data.form</field>
        <field name="model">books.borrows</field>
        <field name="arch" type="xml">
            <form string="Borrowers">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_ongoing" type="object" string="Ongoing"
                            invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_done" type="object" string="Done"
                            invisible="state != 'ongoing'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'done'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft, confirmed,ongoing,done"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="True"/>
                            <field name="name_id" readonly="state!='draft'" force_save="1"/>
                            <field name="book_id" readonly="state!='draft'" force_save="1"/>
                            <field name="start_borrow"/>
                            <field name="email"/>
                            <field name="phone_number"/>
                            <field name="sub_total"/>
                            <field name="total_money"/>
                        </group>
                        <group>
                            <field name="end_borrow"/>
                            <!--                <field name="category_ids"/>-->
                            <!--                <field name="author_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>-->
                            <field name="daily_price" optional="hide"/>
                            <field name="color" widget="color_picker"/>
                            <field name="duration"/>
                            <field name="received_date" readonly="state!='draft'" force_save="1"/>
                            <field name="delay_duration" readonly="state!='draft'" force_save="1"/>
                            <field name="borrows_duration" readonly="state!='draft'" force_save="1"/>
                            <field name="create_uid"/>
                        </group>
                        <group>

                            <!--                        <field name="book_copy_list_id "/>-->
                        </group>
                    </group>
                    <notebook>
                        <page name="Other Borrowers Info" string="Other Info">

                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" group="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="view_action_borrowed_tree">
        <field name="name">view.books.data.tree</field>
        <field name="arch" type="xml">
            <tree decoration-success="state=='done'" decoration-danger="state=='ongoing'"
                  decoration-info="state=='confirmed'" decoration-warning="state=='draft'" sample="1" multi_edit="1"
                  default_order="start_borrow desc" string="Borrows">
                <field name="reference"/>
                <field name="name_id"/>
                <field name="book_id"/>
                <field name="start_borrow"/>
                <field name="email"/>
                <field name="phone_number"/>
                <field name="end_borrow"/>
                <field name="daily_price" optional="hide"/>
                <!--                <field name="category_ids"/>-->
                <!--                <field name="author_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>-->
                <field name="color" widget="color_picker"/>
                <field name="duration"/>
                <field name="received_date"/>
                <field name="delay_duration"/>
                <field name="borrows_duration"/>
                <field name="sub_total"/>
                <field name="total_money"/>
                <field name="state" decoration-success="state=='done'" decoration-info="state=='confirmed'"
                       decoration-warning="state=='draft'" decoration-danger="state=='ongoing'" widget="badge"/>
                <!--                <field name="book_copy_list_id "/>-->
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="view_action_borrowed_search">
        <field name="name">view.action.borrowed.search</field>
        <field name="model">books.borrows</field>
        <field name="arch" type="xml">
            <search string="Borrowers">
                <!--                <field name="reference"></field>-->
                <!--                       filter_domain="['|',('reference','ilike',self),('name_id','ilike',self)]"-->
                <!--                       string="Advanced filter"/>-->
                <!--                <field name="reference"/>-->
                <!--                <field name="name_id"/>-->
                <!--                <field name="book_id"/>-->
                <!--                &lt;!&ndash;                <separator/>&ndash;&gt;-->
                <!--                <group expand="1" string="Group By">-->
                <!--                    <filter name="group_by_reference" string="Reference" context="{'group_by': 'reference'}"/>-->
                <!--                    <filter name="group_by_name" string="Name" context="{'group_by': 'name_id'}"/>-->
                <!--                    <filter name="group_by_books" string="Books" context="{'group_by': 'book_id'}"/>-->
                <!--                </group>-->
                <!--                <searchpanel>-->
                <!--                    <filter name="borrower_reference" string="Reference" enable_counters="1"/>-->
                <!--                    <filter name="borrower_name_id" string="Name" enable_counters="1"/>-->
                <!--                    <filter name="borrower_book_id" string="Books" enable_counters="1"/>-->
                <!--                </searchpanel>-->
                <field name="name_id" filter_domain="[('name','ilike',self)]"/>
                <filter name="filter_ended" string="Ended" domain="[('state','=','done')]"/>
                <filter name="filter_running" string="running" domain="[('state','=','ongoing')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_delay" string="Delayed" domain="[('state','=','delayed')]"/>
                <separator/>
                <filter name="filter_delay" string="date"
                        domain="[('start_borrow','>=', (context_today() - relativedelta(years=1)).strftime('%%Y-%%m-%%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="state" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
                <group expand="0" string="Group By">
                    <filter string="Reference" name="group_by_reference_id" context="{'group_by': 'reference'}"/>
                </group>
                <group expand="0" string="Group By">
                    <filter string="name_id" name="group_by_name" context="{'group_by': 'name_id'}"/>
                </group>
                <group expand="0" string="Group By">
                    <filter string="Books" name="group_by_book_id" context="{'group_by': 'book_id'}"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-users" select="multi" enable_counters="1"/>
                    <field name="name_id" icon="fa-users" select="multi" enable_counters="1"/>
                    <field name="book_id" icon="fa-users" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="view_books_borrows_calendar">
        <field name="name">borrows.calendar</field>
        <field name="model">books.borrows</field>
        <field name="arch" type="xml">
            <calendar string="Borrows Calendar" date_start="start_borrow" date_stop="end_borrow">
                <field name="name_id"/>
            </calendar>
        </field>
    </record>
    <record model="ir.ui.view" id="view_borrows_pivot">
        <field name="name">borrows.pivot</field>
        <field name="model">books.borrows</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="state"/>
                <field name="name_id" type="row"/>
                <field name="book_id" type="row"/>
            </pivot>
        </field>
    </record>
    <record model="ir.ui.view" id="view_books_borrows_kanban">
        <field name="name">borrows.kanban</field>
        <field name="model">books.borrows</field>
        <field name="arch" type="xml">
            <kanban default_order="id desc">
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li>
                                        Name:
                                        <field name="name_id"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_borrowed" model="ir.actions.act_window">
        <field name="name">Borrows</field>
        <field name="res_model">books.borrows</field>
        <field name="view_mode">tree,form,calendar,pivot,kanban</field>
        <field name="search_view_id" ref="view_action_borrowed_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create books borrowers.
            </p>
        </field>
    </record>
</odoo>