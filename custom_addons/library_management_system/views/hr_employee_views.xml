<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="view_hr_employee_action_form" model="ir.ui.view">
            <field name="name">ir.actions.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="placeholder">Name</attribute>
                </xpath>
                <xpath expr="//field[@name='job_title']" position="attributes">
                    <attribute name="placeholder">Identification No</attribute>
                </xpath>
                <xpath expr="//field[@name='category_ids']" position="attributes">
                    <attribute name="placeholder">e.g Part Time</attribute>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="attributes">
                    <field name="department" required="True">department</field>
                </xpath>
                <field name="work_email" position="after">
                    <field name="location"/>
                </field>
                <xpath expr="//notebook//page[@name='hr_settings']" position="before">
                    <page string="EXPERIENCE">
                        <div>
                            <h2>Academic Experiences</h2>
                        </div>
                        <notebook colspan="4">
                            <page name="experience" string="Academic Experiences">
                                <control>
                                    <create name="add_item" string="Add an Item"/>
                                </control>
                                <group>
                                    <group>
                                        <field name="academic_experience"/>
                                        <field name="start_date" class="fa-time"/>
                                        <field name="expire"/>
                                    </group>
                                </group>
                            </page>
                            <page name="institution" string="Institution">
                                <group>
                                    <group>
                                        <field name="institution"/>
                                        <field name="institution_location"/>
                                    </group>
                                </group>
                            </page>
                            <page name="diploma" string="Diploma">
                                <group>
                                    <group>
                                        <field name="diploma"/>
                                    </group>
                                </group>
                            </page>
                            <page name="study" string="Field of study">
                                <group>
                                    <group>
                                        <field name="field_of_study"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <field name="comment" placeholder="Internal notes..."/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </page>
                </xpath>
                <xpath expr="//notebook//page[@name='public']" position="attributes">
                    <attribute name="string">PUBLIC INFORMATION</attribute>
                </xpath>
                <xpath expr="//notebook//page[@name='personal_information']" position="attributes">
                    <attribute name="string">PERSONAL INFORMATION</attribute>
                </xpath>
                <xpath expr="//notebook//page[@name='hr_settings']" position="attributes">
                    <attribute name="string">HR SETTINGS</attribute>
                </xpath>
            </field>
        </record>
        <record id="hr_employees_action" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,tree,form,activity</field>
        </record>
    </data>
</odoo>